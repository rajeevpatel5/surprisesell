# ============================================================================
# SurpriseSell — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/iot_lab?schema=public"

# --- Auth (NextAuth) ---------------------------------------------------------
# For local/MVP auth. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://surprisesell.com"

# --- Stripe (buy / mail rent) ------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- AWS Cognito (production auth — MVP falls back to local credentials) ----
AWS_REGION=""
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
COGNITO_CLIENT_SECRET=""

# --- AWS IoT Core (device connectivity) -------------------------------------
AWS_IOT_ENDPOINT=""
AWS_IOT_ROLE_ARN=""
AWS_IOT_POLICY_NAME=""

# --- AWS core services --------------------------------------------------------
AWS_S3_BUCKET=""
AWS_CLOUDFRONT_DOMAIN=""
AWS_LAMBDA_GRADING_FN=""
AWS_ACCOUNT_ID=""

# --- MQTT (local/dev broker; production uses AWS IoT Core) -----------------
MQTT_BROKER_URL="mqtt://localhost:1883"

# --- Live camera (remote lab video) ------------------------------------------
LIVE_VIDEO_STREAM_PROVIDER=""
